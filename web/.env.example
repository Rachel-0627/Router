# ============================================
# 复制本文件为 .env.local 并填入真实值
# .env.local 已在 .gitignore 中,绝不会提交
# ============================================

# --- 应用 ---
APP_URL=http://localhost:3000
APP_NAME="AI Gateway"

# --- 数据库 (Supabase 或 Neon 的 Postgres 连接串) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- 上游网关 new-api (阶段2 起需要) ---
NEWAPI_BASE_URL=https://api.your-domain.com
NEWAPI_ADMIN_TOKEN=

# --- 定价 (阶段1 起需要) ---
# 售价 = list price × 这个比例。0.40 = 四折(便宜60%)
PRICE_RATIO_OF_OFFICIAL=0.40

# --- 支付 Creem (阶段3 起需要) ---
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# --- 支付 Paddle (阶段3 备用通道) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- 认证 (阶段2 起需要) ---
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 告警 (阶段5 起需要) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
