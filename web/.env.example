# ============================================
# 复制为 .env.local 填本地值;线上填进 Vercel 环境变量
# .env.local 已在 .gitignore,不会提交
# ============================================

# ── 阶段1(营销站)必需 —— 只要这三个就能部署 ──
APP_URL=https://globalrouterai.com
APP_NAME=GlobalRouter
# 售价 = list price × 这个比例。0.80 = 八折(便宜20%)
PRICE_RATIO_OF_OFFICIAL=0.80

# ── 阶段3(认证/计费)起需要 ──
# Supabase 或 Neon 的 Postgres 连接串
DATABASE_URL=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 阶段2(网关)起需要 ──
# 这是**上游 new-api 实例**的地址,不是本站域名。
# 填成自己的域名会让网关转发给自己 —— 无限自调用,把额度烧光。
# 本地开发指向 mock:http://localhost:3099(npm run mock:upstream)
NEWAPI_BASE_URL=
NEWAPI_ADMIN_TOKEN=

# ── 阶段4(支付)起需要 ──
# 主力通道:nowpayments | creem | paddle
# nexapay 已下线:实测是 $79/月订阅制入金聚合器,不是按笔收费的网关,
# 且其通道要求终端用户做 KYC。
PAYMENT_PROVIDER=nowpayments
# 加密货币收款。按笔 1%,无月费,无需公司主体
NOWPAYMENTS_API_KEY=
# ⚠️ 和 API Key 是两个不同的值,别填反
NOWPAYMENTS_IPN_SECRET=
# webhook 地址里的随机段,防止回调被伪造。用 openssl rand -hex 16 生成
PAYMENT_WEBHOOK_PATH_SECRET=
# ── Creem(Merchant of Record,推荐)──
# 先在 https://creem.io 注册,左下角切到 Test Mode 拿测试 key
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# true = 用沙箱 test-api.creem.io(测试 key 只能配这个)
CREEM_TEST_MODE=true
# 充值档位 → 产品 ID。跑 `npm run creem:setup` 自动建好并打印这一行
CREEM_PRODUCTS=
# 回调地址填到 Creem 后台 Developers > Webhook:
#   https://你的域名/api/webhook/creem/<PAYMENT_WEBHOOK_PATH_SECRET>

# 备用通道
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# ── 阶段5(告警)起需要 ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
