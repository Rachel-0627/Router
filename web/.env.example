# ============================================
# 复制为 .env.local 填本地值;线上填进 Vercel 环境变量
# .env.local 已在 .gitignore,不会提交
# ============================================

# ── 阶段1(营销站)必需 —— 只要这三个就能部署 ──
APP_URL=https://globalrouterai.com
APP_NAME=GlobalRouter
# 售价 = list price × 这个比例。0.40 = 四折(便宜60%)
PRICE_RATIO_OF_OFFICIAL=0.40

# ── 阶段3(认证/计费)起需要 ──
# Supabase 或 Neon 的 Postgres 连接串
DATABASE_URL=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 阶段2(网关)起需要 ──
NEWAPI_BASE_URL=https://api.globalrouterai.com
NEWAPI_ADMIN_TOKEN=

# ── 阶段4(支付)起需要 ──
# 主力通道:nexapay | creem | paddle
PAYMENT_PROVIDER=nexapay
NEXAPAY_API_KEY=
# webhook 地址里的随机段,防止回调被伪造。用 openssl rand -hex 16 生成
PAYMENT_WEBHOOK_PATH_SECRET=
# 备用通道
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# ── 阶段5(告警)起需要 ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
